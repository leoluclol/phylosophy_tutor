# LLM provider (OpenRouter). Copy this file to `.env` and fill in your key.
# Never commit the real `.env`.
OPENROUTER_API_KEY=

# Telegram delivery (used by send_daily.py / daily_lesson.sh cron job).
# Create a bot with @BotFather, then:
#   TELEGRAM_BOT_TOKEN = the token BotFather gives you
#   TELEGRAM_USER_ID   = your numeric user id (ask @userinfobot for it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=